# .env.secrets.example
# Copy this file to .env.secrets (gitignored), fill in real values,
# then run: bash scripts/setup-eas-secrets.sh
#
# Keys named ORG_GRADLE_PROJECT_* are automatically picked up by Gradle
# via project.findProperty() without any extra configuration.

# ── xAI (Grok Realtime Voice + LLM) ──────────────────────────────────────────
ORG_GRADLE_PROJECT_XAI_API_KEY=REPLACE_ME

# ── ElevenLabs (Caroline TTS voice) ──────────────────────────────────────────
ORG_GRADLE_PROJECT_ELEVENLABS_API_KEY=REPLACE_ME

# ── OpenRouter (fallback LLM relay) ──────────────────────────────────────────
ORG_GRADLE_PROJECT_OPENROUTER_API_KEY=REPLACE_ME

# ── vLLM (self-hosted LLM base URL, e.g. http://your-runpod-ip:8000) ────────
ORG_GRADLE_PROJECT_VLLM_BASE_URL=REPLACE_ME

# ── Fish Speech (self-hosted TTS base URL) ────────────────────────────────────
ORG_GRADLE_PROJECT_FISH_SPEECH_BASE_URL=REPLACE_ME

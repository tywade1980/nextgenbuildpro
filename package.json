{
  "name": "nextgenbuildpro",
  "version": "2.0.0",
  "private": true,
  "description": "NextGen Build Pro — Unified Android AI platform",
  "scripts": {
    "eas:init":            "eas init --id \"REPLACE_WITH_EAS_PROJECT_ID\"",
    "eas:build:dev":       "eas build --platform android --profile development",
    "eas:build:preview":   "eas build --platform android --profile preview",
    "eas:build:prod":      "eas build --platform android --profile production",
    "eas:submit":          "eas submit --platform android --profile production",
    "eas:credentials":     "eas credentials --platform android",
    "eas:secrets:push":    "bash scripts/setup-eas-secrets.sh",
    "eas:secrets:list":    "eas secret:list --scope project"
  },
  "devDependencies": {
    "eas-cli": "^14.0.0"
  }
}
